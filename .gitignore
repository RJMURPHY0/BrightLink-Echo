# Virtual environment
venv/

# Claude Code session data (path-scoped rules are tracked so every machine gets them)
.claude/*
!.claude/rules/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# SENSITIVE — never commit real credentials or session tokens
config.json
.session
.env

# Runtime / generated files
.ftc_pid
app_log.txt
app_err.txt
app_log_test.txt
debug_log.txt
startup_debug.txt
startup_test.txt

# Build / packaging artefacts (outputs only — ftc_whisper.spec is kept)
build/
dist/
*.egg-info/

# Claude Code assistant memory (not project source)
memory/

# Build logs + dream/memory backup dumps (local artefacts, not source)
build_*.log
build-*.log
memory-backup-dream-*/
backup-dream-*/

# Headless audit run logs — 800+ regenerating prompt/result dumps, not source
.claude-flow/logs/headless/

# graphify knowledge graph — generated locally from AST, rebuild free with /graphify .
graphify-out/

# Secrets: never commit (added 2026-10-08)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
prod-env.txt
